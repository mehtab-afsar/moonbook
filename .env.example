# ── Supabase ─────────────────────────────────────────────────────────────────
# REQUIRED. Local values come from `npx supabase status`.
# Hosted: Project Settings → API.
#
# Moonbook runs on the 56xxx port block. LedgerFlow holds 55321–55329 and
# Qcombinator holds 54321–54327, so all three local stacks can run at once.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:56321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# REQUIRED, SERVER ONLY. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Direct Postgres connection, used by scripts/ and migration smoke tests.
SUPABASE_DB_URL=postgresql://postgres:postgres@127.0.0.1:56322/postgres

# ── App ──────────────────────────────────────────────────────────────────────
# REQUIRED. Absolute origin. Embedded in emailed sign-in links and document
# links, so a wrong value ships broken links.
NEXT_PUBLIC_APP_URL=http://localhost:3000
